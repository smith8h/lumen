{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.1.0",
  "description": "A fast, beautiful Spotlight-style launcher for Linux — apps, files, calculator, web and terminal in one glassy panel.",
  "main": "./out/main/index.js",
  "desktopName": "lumen.desktop",
  "author": {
    "name": "Hussein Shakir",
    "email": "husseinshakir81@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/OWNER/lumen",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/lumen.git"
  },
  "keywords": [
    "launcher",
    "spotlight",
    "linux",
    "gnome",
    "electron",
    "productivity"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux AppImage deb --publish never",
    "dist:dir": "electron-vite build && electron-builder --linux dir --publish never",
    "icons": "electron scripts/make-icons.cjs",
    "extension:pack": "node scripts/pack-extension.cjs",
    "extension:install": "node scripts/pack-extension.cjs --install",
    "extension:nested": "scripts/extension-nested.sh"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "mathjs": "^15.2.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
